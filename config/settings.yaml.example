# Budget Analyzer Configuration
# ==============================
# Copy this file to settings.yaml and customize for your data.

# Time period for analysis
year: 2025
title: "Spending Analysis"

# Currency display format (default: "${amount}")
# Use {amount} as placeholder for the formatted number
# currency_format: "${amount}"      # US Dollar (prefix)
# currency_format: "{amount} zł"    # Polish Złoty (suffix)
# currency_format: "€{amount}"      # Euro (prefix)
# currency_format: "£{amount}"      # British Pound (prefix)

# Data sources - list of transaction files to process
# Paths are relative to the parent of the config directory
# Supports glob patterns (*, ?, []) to match multiple files
data_sources:
  - name: AMEX
    file: data/amex-2025.csv      # Single file
    type: amex
  # Example with glob pattern to match multiple files:
  # - name: AMEX
  #   file: data/amex*.csv        # Matches amex-2024.csv, amex-2025.csv, etc.
  #   type: amex
  - name: BOA
    file: data/boa-checking.txt
    type: boa
  # Folder + glob examples (CSV only):
  # - name: Exports (top-level only)
  #   file: data/exports/          # loads all *.csv in this folder
  # - name: Monthly Exports
  #   file: data/exports/*.csv     # top-level glob
  # - name: All Exports (recursive)
  #   file: data/exports/**/*.csv  # recursive glob
  # European format example (semicolon-delimited with comma decimals):
  # - name: European Bank
  #   file: data/export.csv
  #   format: "{date:%d-%m-%Y},{description},{amount}"
  #   delimiter: ";"           # Semicolon-separated columns
  #   decimal: ","             # 1.234,56 format (comma = decimal, period = thousands)

  # Multi-column description example:
  # Some banks split transaction info across columns (e.g., type + recipient).
  # Use custom captures to combine them:
  # - name: European Bank
  #   file: data/bank.csv
  #   format: "{date:%d.%m.%Y},{_},{txn_type},{vendor},{_},{amount}"
  #   columns:
  #     description: "{vendor} ({txn_type})"  # Combines columns into description

  # Per-source report_fields override (when columns differ per account):
  # - name: Wells Fargo Visa
  #   file: data/visa.csv
  #   format: "{date:%m/%d/%Y},{description},{memo},{amount}"
  #   report_fields: [memo]

# Capture columns to surface in the report's transaction details popup.
# Any name here that a source's format string captures - e.g. {memo} - is shown
# when non-blank; transactions without a value get no details badge. Names a
# source does not capture are ignored, so a global list is safe with mixed
# formats. A source-level report_fields replaces this list for that source.

report_fields:
  - memo

# Recurrence override tags (used by report charts)
# ------------------------------------------------
# Add these tags in merchants.rules when you want to override inferred
# recurring classification in the charts:
#   fixed    -> force merchant into fixed/recurring spend
#   variable -> force merchant out of fixed/recurring spend

# Categorization review file (default: true)
# When merchants_file is set and unknown merchants remain after `tally up`,
# tally writes config/categorization.yaml (+ hints and schema) listing them
# for review. Set to false to disable this generation entirely.
#
# Disabling never deletes files already generated — they hold answers you may
# have typed. Tally warns that they are stale instead; delete them yourself.
# generate_categorization_file: false

# Output settings
output_dir: output
html_filename: spending_summary.html